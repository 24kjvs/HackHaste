# HackHaste Left Android KeyCharacterMap (physical overlay)
# HackHaste keyboard layout. Dr. Marcus Roe, https://drm.cc/ . MIT License.
# Settings → System → Languages → Physical keyboard, after the
# layout-provider app is installed; or drop this file under
# /system/usr/keychars/ as a device-specific overlay (root).

type OVERLAY

# Caps Lock (Linux/Android keycode 58) is Left Ctrl.
map key 58 CTRL_LEFT
# Physical Left Ctrl (keycode 29) is Caps Lock. Shiftlock variants
# still use CAPS_LOCK; every key below lists capslock: so it shifts all.
map key 29 CAPS_LOCK

key GRAVE {
    label:                              '`'
    base:                               '`'
    shift:                              '~'
    capslock:                           '`'
    ralt:                               '\u0303'
    shift+ralt:                         '~'
    ctrl, meta:                         none
}

