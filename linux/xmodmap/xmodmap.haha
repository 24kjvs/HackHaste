! HackHaste keyboard layout. Dr. Marcus Roe, https://drm.cc/ . MIT License.
! xmodmap for HackHaste. For ancient X11 without working XKB.
! Usage: xmodmap xmodmap.haha
! Caps Lock is remapped to Control_L; physical Left Ctrl is Caps_Lock.

keycode  49 =              grave         asciitilde         dead_tilde         asciitilde
keycode  10 =                  1             exclam         exclamdown        onesuperior
keycode  11 =                  2                 at          masculine        twosuperior
keycode  12 =                  3         numbersign        ordfeminine      threesuperior
keycode  13 =                  4             dollar               cent           sterling
keycode  14 =                  5            percent           EuroSign                yen
keycode  15 =                  6        asciicircum            hstroke            Hstroke
keycode  16 =        bracketleft          braceleft      guillemotleft          0x1002039
keycode  17 =       bracketright         braceright     guillemotright          0x100203a
keycode  18 =                  v                  V                 oe                 OE
keycode  19 =                  x                  X    dead_circumflex         asciitilde
keycode  20 =                  z                  Z                 ae                 AE
keycode  21 =                  q                  Q         adiaeresis         Adiaeresis
keycode  24 =                  7          ampersand                eth                ETH
keycode  25 =                  8           asterisk              thorn              THORN
keycode  26 =                  9          parenleft leftsinglequotemark leftdoublequotemark
keycode  27 =                  0         parenright rightsinglequotemark rightdoublequotemark
keycode  28 =              minus         underscore             endash             emdash
keycode  29 =                  k                  K     dead_abovering         asciitilde
keycode  30 =                  l                  L            lstroke            Lstroke
keycode  31 =                  c                  C           ccedilla           Ccedilla
keycode  32 =                  g                  G        dead_ogonek         asciitilde
keycode  33 =                  y                  Y         udiaeresis         Udiaeresis
keycode  34 =                  w                  W              aring              Aring
keycode  35 =          semicolon              colon         odiaeresis         Odiaeresis
keycode  51 =          backslash                bar         asciitilde         asciitilde
keycode  38 =                  u                  U             uacute             Uacute
keycode  39 =                  i                  I             iacute             Iacute
keycode  40 =                  a                  A             aacute             Aacute
keycode  41 =                  e                  E             eacute             Eacute
keycode  42 =                  o                  O             oacute             Oacute
keycode  43 =                  h                  H         dead_caron         asciitilde
keycode  44 =                  r                  R         dead_grave         asciitilde
keycode  45 =                  s                  S             ssharp         asciitilde
keycode  46 =                  t                  T         dead_acute   dead_doubleacute
keycode  47 =                  n                  N             ntilde             Ntilde
keycode  48 =                  p                  P             oslash           Ooblique
keycode  52 =         apostrophe           quotedbl             otilde             Otilde
keycode  53 =              comma               less       dead_cedilla         asciitilde
keycode  54 =             period            greater      dead_abovedot         asciitilde
keycode  55 =              slash           question       questiondown         asciitilde
keycode  56 =              equal               plus           multiply           division
keycode  57 =                  j                  J            dstroke            Dstroke
keycode  58 =                  m                  M        dead_macron         asciitilde
keycode  59 =                  d                  D     dead_diaeresis         asciitilde
keycode  60 =                  b                  B         dead_breve         asciitilde
keycode  61 =                  f                  F             atilde             Atilde
keycode  94 =              minus         underscore             endash             emdash
keycode  65 =              space              space              space       nobreakspace

keycode  66 = Control_L Control_L Control_L Control_L
keycode 113 = Mode_switch Mode_switch
keycode  37 = Caps_Lock Caps_Lock Caps_Lock Caps_Lock
clear Lock
clear Control
add Control = Control_L Control_R
add Lock = Caps_Lock
