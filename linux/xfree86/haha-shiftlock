// XFree86 / X.Org 6.x symbols for HackHaste Shift Lock.
partial default alphanumeric_keys modifier_keys
xkb_symbols "basic" {
    include "haha(basic)"
    name[Group1]= "HackHaste Shift Lock";
    // Physical Left Control latches Shift for digits, punctuation,
    // and letters. Right Control stays Control. Caps stays Control.
    replace key <LCTL> { [ Shift_Lock ], type[group1] = "ONE_LEVEL" };
    modifier_map Shift { Shift_Lock };
};
