# HackHaste keymap for NetBSD console.
# HackHaste keyboard layout. Dr. Marcus Roe, https://drm.cc/ . MIT License.
# copy to /usr/share/wscons/keymaps/pckbd.haha.iso8859-1
# modify the mapfile setting in /etc/wscons.conf

keycode  41 =            grave       asciitilde       dead_tilde       asciitilde
keycode   2 =              one           exclam       exclamdown      onesuperior
keycode   3 =              two               at        masculine      twosuperior
keycode   4 =            three       numbersign      ordfeminine    threesuperior
keycode   5 =             four           dollar             cent         sterling
keycode   6 =             five          percent             euro              yen
keycode   7 =              six      asciicircum          hstroke          Hstroke
keycode   8 =      bracketleft        braceleft    guillemotleft       asciitilde
keycode   9 =     bracketright       braceright   guillemotright       asciitilde
keycode  10 =                v                V               oe               OE
keycode  11 =                x                X  dead_circumflex       asciitilde
keycode  12 =                z                Z               ae               AE
keycode  13 =                q                Q       adiaeresis       Adiaeresis
keycode  16 =            seven        ampersand              eth              ETH
keycode  17 =            eight         asterisk            thorn            THORN
keycode  18 =             nine        parenleft           U+2018           U+201C
keycode  19 =             zero       parenright           U+2019           U+201D
keycode  20 =            minus       underscore           endash           emdash
keycode  21 =                k                K   dead_abovering       asciitilde
keycode  22 =                l                L          lstroke          Lstroke
keycode  23 =                c                C         ccedilla         Ccedilla
keycode  24 =                g                G      dead_ogonek       asciitilde
keycode  25 =                y                Y       udiaeresis       Udiaeresis
keycode  26 =                w                W            aring            Aring
keycode  27 =        semicolon            colon       odiaeresis       Odiaeresis
keycode  43 =        backslash              bar       asciitilde       asciitilde
keycode  30 =                u                U           uacute           Uacute
keycode  31 =                i                I           iacute           Iacute
keycode  32 =                a                A           aacute           Aacute
keycode  33 =                e                E           eacute           Eacute
keycode  34 =                o                O           oacute           Oacute
keycode  35 =                h                H       dead_caron       asciitilde
keycode  36 =                r                R       dead_grave       asciitilde
keycode  37 =                s                S           ssharp       asciitilde
keycode  38 =                t                T       dead_acute dead_doubleacute
keycode  39 =                n                N           ntilde           Ntilde
keycode  40 =                p                P           oslash         Ooblique
keycode  44 =       apostrophe         quotedbl           otilde           Otilde
keycode  45 =            comma             less     dead_cedilla       asciitilde
keycode  46 =           period          greater    dead_abovedot       asciitilde
keycode  47 =            slash         question     questiondown       asciitilde
keycode  48 =            equal             plus         multiply         division
keycode  49 =                j                J          dstroke          Dstroke
keycode  50 =                m                M      dead_macron       asciitilde
keycode  51 =                d                D   dead_diaeresis       asciitilde
keycode  52 =                b                B       dead_breve       asciitilde
keycode  53 =                f                F           atilde           Atilde
keycode  86 =            minus       underscore           endash           emdash
keycode  57 =            space            space            space     nobreakspace
keycode  58 =        Control       Control          Control           Control
keycode 184 =    Mode_switch   Mode_switch
keycode  29 =    Caps_Lock     Caps_Lock
